SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_project_service_role_or_secret_key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
WHATSAPP_AGENT_MODEL=claude-sonnet-5

# Safety kill-switch. Keep false until the WhatsApp number has 1-2 weeks of normal
# human usage. While false, incoming messages are still received and persisted --
# nothing is ever sent automatically.
AUTO_RESPOND_ENABLED=false

# E.164 digits only, no leading '+' (e.g. 5521999999999) -- used only for pairing.
WHATSAPP_BUSINESS_PHONE_NUMBER=
WHATSAPP_PAIRING_MODE=false

# Shared secret with services/metaapi-gateway -- must be the EXACT same value in both
# .env files. Used to call POST /internal/whatsapp/create-checkout-session.
WHATSAPP_SERVICE_SECRET=
GATEWAY_INTERNAL_URL=http://127.0.0.1:3001
PUBLIC_APP_URL=https://fortify-delta.vercel.app

WHATSAPP_DAILY_MESSAGE_LIMIT_PER_LEAD=40
PORT=3002
