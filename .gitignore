# Supabase CLI local cache/state
supabase/.temp/
supabase/.branches/

# Claude Code: only the local/personal override file is machine-specific.
# .claude/agents, .claude/skills, .claude/commands, .claude/settings.json are
# shared project config and must stay tracked.
.claude/settings.local.json

# Playwright MCP tool artifacts (screenshots/console logs), not project content
.playwright-mcp/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.vercel

# Capturas e rascunhos de sessão que ficam na raiz.
# Não são do projeto: vêm de verificação em navegador e de trabalhos avulsos.
# Padrão só na RAIZ (barra inicial), para não alcançar assets em public/ e src/.
/*.png
/*.txt
/snapshot_full.txt
/estagio_dev_remote.md
/sdr_search1.md
/search2.md
/search_results_snapshot.md

# Saídas de ferramenta, não código do produto
/output/
